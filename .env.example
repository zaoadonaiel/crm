# ── App ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME="Davey CRM"
NEXT_PUBLIC_APP_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
# generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# comma-separated; these emails always become admins when they sign up
ADMIN_EMAILS=you@yourdomain.com

# ── Database (Neon) ──────────────────────────────────────────────────
# Local dev without Neon: run `npm run db:local` and use the line below
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/postgres
DATABASE_URL=

# ── Google sign-in (optional, from Google Cloud console) ────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Email ─────────────────────────────────────────────────────────────
# resend (default) or mailgun. With no key set, emails print to the console.
EMAIL_PROVIDER=resend
EMAIL_FROM=hello@mail.yourdomain.com
EMAIL_FROM_NAME="Davey"
RESEND_API_KEY=
# Signing secret of the Resend webhook (whsec_...)
RESEND_WEBHOOK_SECRET=
MAILGUN_API_KEY=
MAILGUN_DOMAIN=mail.yourdomain.com
# https://api.eu.mailgun.net for EU accounts
MAILGUN_API_BASE=https://api.mailgun.net
MAILGUN_WEBHOOK_SIGNING_KEY=
# Domain that receives replies: reply+<conversation>@INBOUND_EMAIL_DOMAIN
INBOUND_EMAIL_DOMAIN=reply.yourdomain.com

# ── Stripe ────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Trigger.dev (background jobs) ────────────────────────────────────
TRIGGER_SECRET_KEY=
TRIGGER_PROJECT_REF=
# Shared secret for /api/cron (used by Trigger.dev or any scheduler)
CRON_SECRET=


# Public URL of the app (runtime). Set to your custom domain in production.
APP_URL=http://localhost:3000
# Extra comma-separated origins allowed to sign in (e.g. the workers.dev URL)
TRUSTED_ORIGINS=
